# ============================================================
# GSTPilot Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# --- Application ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (PostgreSQL / Neon) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gstpilot?schema=public"

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Logging ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# --- Razorpay (Payments) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Email Notifications & SMTP (Gmail) ---
EMAIL_FROM="GSTPilot <gstpilot.official@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="gstpilot.official@gmail.com"
# 16-character Google App Password from: https://myaccount.google.com/apppasswords
SMTP_PASS=""

# --- AI Provider ---
# gemini | openai | grok
GEMINI_API_KEY=""
GROK_API_KEY=""

# --- Bootstrap admin (used by pnpm db:seed only) ---
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
