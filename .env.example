# ============================================================
# GSTPilot Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# --- Application ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gstpilot?schema=public"

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Logging ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

+ # --- Razorpay (Payments) ---
+ RAZORPAY_KEY_ID=
+ RAZORPAY_KEY_SECRET=
+ RAZORPAY_WEBHOOK_SECRET=
+ NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Storage (Cloudflare R2 / S3-compatible) — optional until upload features ship ---
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""

# --- AI Provider — optional until AI features ship ---
# gemini | openai | claude
AI_PROVIDER="gemini"
AI_API_KEY=""

# --- Email (Notifications) — optional until notification features ship ---
EMAIL_FROM=""
EMAIL_SERVER_URL=""

# Bootstrap admin (used by pnpm db:seed only)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
