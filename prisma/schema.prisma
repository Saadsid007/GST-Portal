// =============================================================================
// GSTTool Schema — Simplified Marketplace to GSTR-1 Converter
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Authentication Models (Better Auth compatible)
// -----------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("USER") // "USER", "ADMIN"
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sessions        Session[]
  accounts        Account[]
  profiles        GstinProfile[]
  ecoOperators    EcoOperatorGstin[]
  conversions     ConversionHistory[]
  mappingProfiles MappingProfile[]
  settings        UserSettings?

  wallet             Wallet?
  rechargeOrders     RechargeOrder[]
  referralCode       ReferralCode?
  referralTokens     ReferralToken[]
  referralsMade      Referral[]             @relation("Referrer")
  referralReceived   Referral?              @relation("Referee")
  subscription       Subscription?
  gstinCapacity      GSTINCapacity?
  gstinPurchases     AdditionalGSTINPurchase[]
  gstinCreationLogs  GstinCreationLog[]
  payments           Payment[]
  billingAuditLogs   BillingAuditLog[]
  auditLogs          AuditLog[]
  creditCodesCreated CreditCode[]
  codeRedemptions    CreditCodeRedemption[]
  supportTickets     SupportTicket[]
  marketingSubscriber MarketingSubscriber?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("verification")
}

// -----------------------------------------------------------------------------
// GST Profiles & Company Details
// -----------------------------------------------------------------------------

model GstinProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  gstinNumber  String   @map("gstin_number")
  legalName    String   @map("legal_name")
  tradeName    String?  @map("trade_name")
  /// Nature of business. Plain string, not an enum, so adding a category is a
  /// data change rather than a migration. Allowed values live in
  /// features/profile/domain/business-type.ts.
  businessType String   @default("OTHER") @map("business_type")
  stateCode    String   @map("state_code")
  stateName    String   @map("state_name")
  isDefault    Boolean  @default(false) @map("is_default")
  /// Lifecycle status. Only ACTIVE consumes capacity. Allowed values live in
  /// features/billing/domain/gstin-capacity.ts (GstinStatus). Kept as a plain
  /// string so adding a state is a data change, not a migration.
  status          String    @default("ACTIVE")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz
  statusChangedAt DateTime  @default(now()) @map("status_changed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One profile per GSTIN per workspace across all statuses: a GSTIN the user
  /// once had is restored, never duplicated. Also the transactional guard that
  /// makes concurrent "add the same GSTIN" requests safe.
  @@unique([userId, gstinNumber])
  @@index([userId])
  @@index([userId, status])
  @@index([gstinNumber])
  @@map("gstin_profile")
}

/// Append-only ledger of GSTIN activations. Under the active-capacity model this
/// is no longer the quota meter (capacity is the live count of ACTIVE profiles);
/// it is the per-billing-period record of how many distinct brand-new GSTINs a
/// workspace has activated, which bounds create-and-recreate abuse via the
/// activation ceiling in features/billing/config/pricing.config.ts. The window
/// is the subscription period, since rows are counted from startDate.
model GstinCreationLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id")
  profileId   String   @map("profile_id") @db.Uuid
  gstinNumber String   @map("gstin_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("gstin_creation_log")
}

/// The GSTIN of a marketplace operator, as it applies to one of the seller's own GSTINs.
///
/// Most marketplace exports omit the operator's GSTIN entirely (Amazon's MTR has no such
/// column), which leaves GSTR-1 Table 14 unfillable from the file alone. Operators register
/// separately in each state, so the value depends on which of the seller's GSTINs is filing —
/// hence the composite key rather than a column on the platform.
model EcoOperatorGstin {
  id String @id @default(uuid()) @db.Uuid

  userId      String @map("user_id")
  /// The seller's own GSTIN this mapping applies to.
  gstinNumber String @map("gstin_number")
  platformId  String @map("platform_id")
  ecoGstin    String @map("eco_gstin")
  ecoName     String @map("eco_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gstinNumber, platformId])
  @@index([userId])
  @@map("eco_operator_gstin")
}

// -----------------------------------------------------------------------------
// Conversion History Log
// -----------------------------------------------------------------------------

model ConversionHistory {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id")
  gstinNumber      String   @map("gstin_number")
  returnPeriod     String   @map("return_period") // Format: MMYYYY e.g., "072025"
  platformId       String   @map("platform_id") // e.g., "amazon", "flipkart", "meesho"
  fileName         String   @map("file_name")
  totalInvoices    Int      @default(0) @map("total_invoices")
  totalTaxable     Decimal  @default(0) @map("total_taxable") @db.Decimal(18, 2)
  totalTax         Decimal  @default(0) @map("total_tax") @db.Decimal(18, 2)
  status           String   @default("COMPLETED") // "COMPLETED", "FAILED"
  tcsStatus        String   @default("NOT_RECONCILED") @map("tcs_status")
  processingTimeMs Int      @default(0) @map("processing_time_ms")
  jsonPayload      Json?    @map("json_payload")
  normalizedData   Json?    @map("normalized_data")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gstinNumber])
  @@index([createdAt])
  @@map("conversion_history")
}

// -----------------------------------------------------------------------------
// Saved Custom Column Mapping Profiles
// -----------------------------------------------------------------------------

model MappingProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id")
  name       String
  platformId String   @map("platform_id")
  mappings   Json     @map("mappings") // Record<string, string>
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platformId])
  @@map("mapping_profile")
}

// -----------------------------------------------------------------------------
// User System Preferences
// -----------------------------------------------------------------------------

model UserSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id")
  defaultGstin       String?  @map("default_gstin")
  defaultPeriod      String?  @map("default_period")
  autoDetectPlatform Boolean  @default(true) @map("auto_detect_platform")
  autoSaveMapping    Boolean  @default(true) @map("auto_save_mapping")
  theme              String   @default("system")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// -----------------------------------------------------------------------------
// Billing — Wallet & Credit Ledger
//
// 1 Credit = ₹1. Credits are Int: exact arithmetic, and they serialize cleanly
// across the Server → Client Component boundary (unlike Decimal).
//
// INVARIANT: `Wallet.balance` is never written outside `wallet.service.ts`.
// Every change goes through creditWallet/debitWallet, which write a
// WalletTransaction row in the same $transaction. The ledger is the source of
// truth; the balance is a materialised running total.
// -----------------------------------------------------------------------------

model Wallet {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id")
  balance             Int      @default(0)
  lifetimeRecharged   Int      @default(0) @map("lifetime_recharged")
  lifetimeUsed        Int      @default(0) @map("lifetime_used")
  bonusEarned         Int      @default(0) @map("bonus_earned")
  referralEarned      Int      @default(0) @map("referral_earned")
  adminCredited       Int      @default(0) @map("admin_credited")
  freeGenerationsUsed Int      @default(0) @map("free_generations_used")
  isFrozen            Boolean  @default(false) @map("is_frozen")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallet")
}

model WalletTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  // "RECHARGE" | "BONUS" | "GENERATION" | "REFERRAL_REWARD" | "ADMIN_CREDIT"
  // | "REFUND" | "ADJUSTMENT" | "PROMO_CODE" | "CAMPAIGN" | "FREE_TRIAL"
  type          String
  creditAmount  Int      @map("credit_amount") // signed: negative for debits
  balanceBefore Int      @map("balance_before")
  balanceAfter  Int      @map("balance_after")
  description   String
  referenceId   String?  @map("reference_id") // order id / conversion id / referral id
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@index([type])
  @@map("wallet_transaction")
}

// -----------------------------------------------------------------------------
// Billing — Razorpay Recharge Orders
// -----------------------------------------------------------------------------

model RechargeOrder {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id")
  /// How the user paid. UPI_QR rows have no Razorpay order — a QR code is a
  /// standalone entity — so exactly one of the two locators below is set.
  method String @default("CHECKOUT") @map("method") // "CHECKOUT" | "UPI_QR"

  razorpayOrderId   String?  @unique @map("razorpay_order_id")
  razorpayQrCodeId  String?  @unique @map("razorpay_qr_code_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  amount            Int // rupees, equals base credits
  bonusCredits      Int      @default(0) @map("bonus_credits")
  totalCredits      Int      @map("total_credits")
  status            String   @default("CREATED") // "CREATED", "PAID", "FAILED"
  // Written inside the same $transaction that credits the wallet. The unique
  // constraint is what makes webhook settlement idempotent against replays.
  webhookEventId    String?  @unique @map("webhook_event_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("recharge_order")
}

// -----------------------------------------------------------------------------
// Billing — Referrals
// -----------------------------------------------------------------------------

model ReferralCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id")
  code      String   @unique // e.g. "GSTP-4D82FK"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_code")
}

model ReferralToken {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  token        String   @unique
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  usedByUserId String?  @map("used_by_user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("referral_token")
}

model Referral {
  id            String    @id @default(uuid()) @db.Uuid
  referrerId    String    @map("referrer_id")
  // Unique: one account can only ever be referred once.
  refereeId     String    @unique @map("referee_id")
  codeUsed      String    @map("code_used")
  status        String    @default("PENDING") // "PENDING", "REWARDED", "BLOCKED"
  rewardedAt    DateTime? @map("rewarded_at") @db.Timestamptz
  refereeGstin  String?   @map("referee_gstin")
  refereeMobile String?   @map("referee_mobile")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([status])
  @@map("referral")
}

// -----------------------------------------------------------------------------
// Billing — Admin-issued Credit Codes
//
// Hand-issued gifts (developers, testers, campaigns). No bonus slab applies:
// a 500-credit code grants exactly 500 credits. Redeeming one does NOT settle
// a pending referral — only a real Razorpay payment does.
// -----------------------------------------------------------------------------

model CreditCode {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  credits         Int
  maxRedemptions  Int       @default(1) @map("max_redemptions")
  redemptionCount Int       @default(0) @map("redemption_count")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  isActive        Boolean   @default(true) @map("is_active")
  note            String?
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  createdBy   User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  redemptions CreditCodeRedemption[]

  @@index([isActive])
  @@map("credit_code")
}

model CreditCodeRedemption {
  id           String   @id @default(uuid()) @db.Uuid
  creditCodeId String   @map("credit_code_id") @db.Uuid
  userId       String   @map("user_id")
  credits      Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  creditCode CreditCode @relation(fields: [creditCodeId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Race guard: an account cannot redeem the same code twice, even concurrently.
  @@unique([creditCodeId, userId])
  @@index([userId])
  @@map("credit_code_redemption")
}

// -----------------------------------------------------------------------------
// Billing — Admin-editable Configuration
//
// Bonus slabs, recharge packs, generation cost, referral rewards, free-trial
// limits and seasonal campaigns all live here so admin can change pricing with
// no code change and no deploy. Constants in features/billing/constants are
// only the seeded defaults / fallback.
// -----------------------------------------------------------------------------

model BillingConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("billing_config")
}

// -----------------------------------------------------------------------------
// Billing — Subscriptions & GSTIN Capacity
// -----------------------------------------------------------------------------

model Subscription {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id")
  plan                   String?   @default("FREE")
  planSlug               String    @default("free_trial") @map("plan_slug") // "free_trial", "starter", "growth", "business", "ca_pro", "ca_firm"
  status                 String    @default("TRIALING") // "TRIALING", "ACTIVE", "PAST_DUE", "CANCELLED", "EXPIRED"
  startDate              DateTime  @default(now()) @map("start_date") @db.Timestamptz
  endDate                DateTime  @default(now()) @map("end_date") @db.Timestamptz
  autoRenew              Boolean   @default(true) @map("auto_renew")
  scheduledPlanSlug      String?   @map("scheduled_plan_slug") // For downgrades scheduled at renewal
  provider               String    @default("RAZORPAY")
  providerSubscriptionId String?   @map("provider_subscription_id")
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  events SubscriptionEvent[]

  @@index([userId])
  @@index([status])
  @@map("subscription")
}

model GSTINCapacity {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id")
  includedGSTINs    Int      @default(7) @map("included_gstins")
  additionalGSTINs  Int      @default(0) @map("additional_gstins")
  usedGSTINs        Int      @default(0) @map("used_gstins")
  effectiveCapacity Int      @default(7) @map("effective_capacity")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gstin_capacity")
}

model AdditionalGSTINPurchase {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id")
  quantity          Int
  pricePerGSTIN     Int      @default(6) @map("price_per_gstin")
  amount            Int // Rupees charged (prorated)
  startDate         DateTime @default(now()) @map("start_date") @db.Timestamptz
  endDate           DateTime @map("end_date") @db.Timestamptz
  providerPaymentId String?  @map("provider_payment_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("additional_gstin_purchase")
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id")
  provider          String   @default("RAZORPAY")
  providerOrderId   String?  @unique @map("provider_order_id")
  providerPaymentId String?  @unique @map("provider_payment_id")
  amount            Int // In rupees
  currency          String   @default("INR")
  status            String   @default("CREATED") // "CREATED", "SUCCESS", "FAILED", "REFUNDED"
  paymentType       String   @map("payment_type") // "SUBSCRIPTION", "ADDITIONAL_GSTIN", "UPGRADE", "RENEWAL"
  planSlug          String?  @map("plan_slug")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("payment")
}

model PaymentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String   @default("RAZORPAY")
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  payloadHash String?  @map("payload_hash")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz
  status      String   @default("PROCESSED")

  @@index([eventId])
  @@map("payment_event")
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  eventType      String   @map("event_type") // "TRIAL_STARTED", "PLAN_ACTIVATED", "PLAN_UPGRADED", "DOWNGRADE_SCHEDULED", "EXPIRED", "RENEWED", "CANCELLED"
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_event")
}

model BillingAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  action    String
  actorId   String   @map("actor_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@map("billing_audit_log")
}

// -----------------------------------------------------------------------------
// Billing — Audit Trail
// -----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_log")
}

/// Offer strip shown above the public header. Admin-managed so campaigns can
/// start and stop without a deploy. Multiple active rows scroll as a marquee,
/// which is also what keeps the strip to one line on a phone.
model Announcement {
  id        String    @id @default(uuid()) @db.Uuid
  message   String
  /// Optional call to action. Both must be set for the link to render.
  linkLabel String?   @map("link_label")
  linkHref  String?   @map("link_href")
  isActive  Boolean   @default(true) @map("is_active")
  /// Lower sorts first within the marquee.
  sortOrder Int       @default(0) @map("sort_order")
  /// Optional schedule. Null on either side means "no bound on that side".
  startsAt  DateTime? @map("starts_at") @db.Timestamptz
  endsAt    DateTime? @map("ends_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive, sortOrder])
  @@map("announcement")
}

/// One inbox for everything a human sends us.
///
/// The public contact form and the in-app support form are the same domain — a
/// message that an admin triages, assigns a status to, and replies on. `source`
/// records which door it came through, so admin gets a single queue instead of
/// two parallel systems that drift apart.
model SupportTicket {
  id        String @id @default(uuid()) @db.Uuid
  /// Short human-quotable reference shown to the sender, e.g. GP-8F3K2A.
  reference String @unique
  /// "CONTACT" (public form) | "SUPPORT" (signed-in user)
  source    String
  /// "PAYMENT" | "CONVERSION" | "ACCOUNT" | "BILLING" | "SALES" | "OTHER"
  category  String @default("OTHER")
  /// "OPEN" | "IN_PROGRESS" | "WAITING_ON_USER" | "RESOLVED" | "CLOSED"
  status    String @default("OPEN")
  /// "LOW" | "NORMAL" | "HIGH" | "URGENT"
  priority  String @default("NORMAL")

  subject String
  message String

  /// Captured for anonymous contact submissions. For signed-in tickets these
  /// mirror the account so the row stays readable if the user is deleted.
  name  String
  email String

  /// Null for public contact submissions.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Free-form context the user attached, e.g. a Razorpay payment id.
  referenceId String? @map("reference_id")

  /// Set when an admin takes ownership.
  assignedToId String?   @map("assigned_to_id")
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz

  replies   SupportTicketReply[]
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([userId])
  @@index([source])
  @@map("support_ticket")
}

/// A message on a ticket. `isFromAdmin` decides which side of the thread it
/// renders on and whether the user is allowed to see it.
model SupportTicketReply {
  id          String        @id @default(uuid()) @db.Uuid
  ticketId    String        @map("ticket_id") @db.Uuid
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body        String
  isFromAdmin Boolean       @default(false) @map("is_from_admin")
  /// Admin-only note: never returned to the user.
  isInternal  Boolean       @default(false) @map("is_internal")
  authorName  String        @map("author_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([ticketId, createdAt])
  @@map("support_ticket_reply")
}

// -----------------------------------------------------------------------------
// CMS — Blog Platform
// -----------------------------------------------------------------------------

model BlogPost {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique
  title           String
  excerpt         String
  content         String    @db.Text
  coverImage      String?   @map("cover_image")
  category        String    @default("Compliance")
  tags            String[]  @default([])
  author          String    @default("GSTPilot Team")
  authorRole      String?   @default("GST Compliance Specialist") @map("author_role")
  authorAvatar    String?   @map("author_avatar")
  readTime        String    @default("5 min read") @map("read_time")
  status          String    @default("DRAFT") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  isFeatured      Boolean   @default(false) @map("is_featured")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  canonicalUrl    String?   @map("canonical_url")
  ogImage         String?   @map("og_image")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([slug])
  @@index([status, publishedAt])
  @@index([category])
  @@index([isFeatured])
  @@map("blog_post")
}

// -----------------------------------------------------------------------------
// Marketing Audience & Campaign Broadcasts
// -----------------------------------------------------------------------------

model MarketingSubscriber {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  userId    String?  @unique @map("user_id")
  source    String   @default("SIGNUP") // "SIGNUP" | "NEWSLETTER" | "LEAD_MAGNET" | "ADMIN_IMPORT"
  status    String   @default("SUBSCRIBED") // "SUBSCRIBED" | "UNSUBSCRIBED" | "BOUNCED"
  planSlug  String   @default("free_trial") @map("plan_slug")
  tags      String[] @default([])
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([planSlug])
  @@map("marketing_subscriber")
}

model CampaignBroadcast {
  id             String    @id @default(uuid()) @db.Uuid
  subject        String
  headline       String
  previewText    String?   @map("preview_text")
  contentHtml    String    @map("content_html") @db.Text
  targetAudience String    @default("ALL") @map("target_audience") // "ALL" | "TRIAL" | "PAID" | "EXPIRED"
  recipientCount Int       @default(0) @map("recipient_count")
  sentCount      Int       @default(0) @map("sent_count")
  failedCount    Int       @default(0) @map("failed_count")
  status         String    @default("DRAFT") // "DRAFT" | "SENDING" | "SENT" | "FAILED"
  adminId        String?   @map("admin_id")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([createdAt])
  @@map("campaign_broadcast")
}

